# Komodo stack env for the music stack (set in the Komodo UI; real values never committed).
DOMAIN=

# Tidarr -> Navidrome (a Navidrome user for library scans and search buttons)
TIDARR_NAVIDROME_USER=
TIDARR_NAVIDROME_PASSWORD=
# Tidarr web UI password (or use the OIDC block in the compose instead)
TIDARR_ADMIN_PASSWORD=
# Tidarr push notifications via the existing ntfy (an access token with write access to the topic)
TIDARR_NTFY_TOKEN=
