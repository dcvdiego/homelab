# Komodo stack env for offsite-backup (never committed). See docs/backups.md#off-site-rustic--rclone.
# Repository key: generated by the ops request. Keep a copy OFF this server (password manager that
# isn't the self-hosted Vaultwarden, or paper): without it the off-site copy can't be read.
RUSTIC_PASSWORD=
# Uptime Kuma push monitor "Backups: off-site (push)", reached over network_default:
# http://uptime-kuma:3001/api/push/<token>
KUMA_PUSH_URL=
# Google Drive caps uploads at 750 GiB/day per account: 8M (MiB/s) stays under it. Leave empty for OneDrive.
RCLONE_BWLIMIT=8M
# Optional overrides
# BACKUP_SCHEDULE=15 3 * * *
# MAINTAIN_DAY=7
# CHECK_SUBSET=5%
