# Komodo stack env for docker-compose/firefly-iii (generated by ops/requests/2026-11-27-firefly-iii.sh).
DOMAIN=
# Exactly 32 characters, letters and digits only (Firefly III won't start otherwise). Never change it
# after the first start: it encrypts sessions and stored secrets.
FIREFLY_APP_KEY=
# Exactly 32 characters, letters and digits: the daily cron URL token
FIREFLY_STATIC_CRON_TOKEN=
# Hex. Set before the first start: MariaDB stores them at initialisation.
FIREFLY_DB_PASSWORD=
FIREFLY_DB_ROOT_PASSWORD=
# Bank-data providers for the importer: optional, add in the Komodo UI (docs/firefly-iii.md).
# Enable Banking key on one line, \n where the newlines were, in double quotes:
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
LUNCH_FLOW_API_KEY=
SIMPLEFIN_TOKEN=
