# /etc/komodo/core/.env on docker-tower (root, 600). Generate secrets with: openssl rand -hex 32
DOMAIN=
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=
KOMODO_WEBHOOK_SECRET=
KOMODO_JWT_SECRET=
# false until the owner has signed up as the first (admin) user, then true
KOMODO_DISABLE_USER_REGISTRATION=false
