# Your root domain (e.g. home.example.com)
DOMAIN=home.example.com

# Cloudflare account email
CF_API_EMAIL=you@example.com

# Cloudflare API token — needs Zone:Read + DNS:Edit for your domain
CF_DNS_API_TOKEN=your-cloudflare-dns-api-token

# Traefik dashboard basic auth
# Generate with: htpasswd -nb admin yourpassword | sed 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_USERS=admin:$$2y$$05$$...hashedpassword...

# CrowdSec bouncer API key — get this after running:
#   docker exec crowdsec cscli bouncers add traefik-bouncer
# Then paste the printed key here and redeploy this stack.
CROWDSEC_BOUNCER_KEY=
